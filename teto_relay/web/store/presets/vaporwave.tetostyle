{
  "format": 1,
  "name": "Vaporwave",
  "author": "Teto Relay",
  "description": "Warm, washed-out and dreamy: dark, chorused, a little lo-fi, a slow lazy vibrato.",
  "settings": {
    "singing_style": "sung",
    "sing_source": "auto",
    "scale": "major",
    "scale_key": "auto",
    "sung_melody_range": 1.0,
    "sung_contour_amount": 0.35,
    "melody_step": 1.5,
    "melody_min_note_seconds": 0.14,
    "vibrato_min_seconds": 0.35,
    "vibrato_depth_cents": 15.0,
    "vibrato_period_ms": 260.0,
    "final_hold_seconds": 0.3,
    "double_voice": 0.3,
    "double_when": "singing",
    "legato": true,
    "expressive": true,
    "emit_contour": true,
    "contour_range_cents": 300.0,
    "contour_smooth_ms": 60.0,
    "tone_gender": 25.0,
    "tone_tension": 0.0,
    "tone_breath": 0.0,
    "tone_voicing": 100.0,
    "note_scoop_cents": 0.0,
    "note_fall_cents": 0.0,
    "consonant_speed": 100.0,
    "note_attack": 100.0,
    "note_release": 0.0,
    "fx_octave": 0.0,
    "fx_bright": -0.5,
    "fx_drive": 0.0,
    "fx_growl": 0.0,
    "fx_growl_hz": 70.0,
    "fx_ring": 0.0,
    "fx_crush": 0.15,
    "fx_band": 0.0,
    "fx_air": 0.0,
    "fx_chorus": 0.6,
    "fx_reverb": 0.45,
    "fx_size": 0.8
  }
}
