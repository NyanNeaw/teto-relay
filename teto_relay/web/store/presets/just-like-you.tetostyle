{
  "format": 1,
  "name": "Just like you",
  "author": "Teto Relay",
  "description": "She follows your voice exactly: your rhythm, your ups and downs. Good for talking.",
  "settings": {
    "singing_style": "speech",
    "scale": "major",
    "scale_key": "auto",
