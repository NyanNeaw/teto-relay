    "vibrato_depth_cents": 35.0,
    "vibrato_period_ms": 185.0,
    "final_hold_seconds": 0.7,
    "double_voice": 1.0,
    "double_when": "singing",
    "legato": true,
    "expressive": true,
    "emit_contour": true,
    "contour_range_cents": 200.0,
    "contour_smooth_ms": 80.0
  }
}
