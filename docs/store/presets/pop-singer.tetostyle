{
  "format": 1,
  "name": "Pop singer",
  "author": "Teto Relay",
  "description": "What you say becomes a tune in a major key, with a light vibrato and a doubled voice.",
  "settings": {
    "singing_style": "sung",
    "scale": "major",
    "scale_key": "auto",
    "sung_melody_range": 1.4,
    "sung_contour_amount": 0.3,
    "melody_step": 1.5,
    "melody_min_note_seconds": 0.14,
    "vibrato_min_seconds": 0.35,
    "vibrato_depth_cents": 30.0,
    "vibrato_period_ms": 170.0,
    "final_hold_seconds": 0.5,
    "double_voice": 0.5,
    "double_when": "singing",
    "legato": true,
    "expressive": true,
    "emit_contour": true,
    "contour_range_cents": 200.0,
    "contour_smooth_ms": 60.0
  }
