{
  "format": 1,
  "name": "Cover song",
  "author": "Teto Relay",
  "description": "For singing a real song over its music: she sings the notes you sing, in your key, bright and doubled like a pop lead.",
  "settings": {
    "singing_style": "sung",
    "sing_source": "notes",
    "scale": "chromatic",
    "scale_key": "auto",
    "sung_melody_range": 1.0,
    "sung_contour_amount": 0.5,
    "melody_step": 1.5,
    "melody_min_note_seconds": 0.14,
    "vibrato_min_seconds": 0.45,
    "vibrato_depth_cents": 25.0,
    "vibrato_period_ms": 180.0,
    "final_hold_seconds": 0.0,
    "double_voice": 0.4,
    "double_when": "singing",
    "legato": true,
    "expressive": true,
    "emit_contour": true,
    "contour_range_cents": 200.0,
    "contour_smooth_ms": 60.0,
    "tone_gender": 0.0,
    "tone_tension": 20.0,
    "tone_breath": 0.0,
    "tone_voicing": 100.0,
    "note_scoop_cents": 0.0,
    "note_fall_cents": 0.0,
    "consonant_speed": 100.0,
    "note_attack": 100.0,
    "note_release": 0.0,
    "fx_octave": 0.0,
    "fx_bright": 0.25,
    "fx_drive": 0.0,
    "fx_growl": 0.0,
    "fx_growl_hz": 70.0,
    "fx_ring": 0.0,
    "fx_crush": 0.0,
    "fx_band": 0.0,
    "fx_air": 0.1,
    "fx_chorus": 0.0,
    "fx_reverb": 0.15,
    "fx_size": 0.3
  }
}
