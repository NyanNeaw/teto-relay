{
  "format": 1,
  "name": "Kawaii",
  "author": "Teto Relay",
  "description": "Tiny and bright, with a fast cute vibrato and an octave up.",
  "settings": {
    "singing_style": "sung",
    "sing_source": "auto",
    "scale": "major",
    "scale_key": "auto",
    "sung_melody_range": 1.6,
    "sung_contour_amount": 0.35,
    "melody_step": 1.5,
    "melody_min_note_seconds": 0.14,
    "vibrato_min_seconds": 0.35,
    "vibrato_depth_cents": 40.0,
    "vibrato_period_ms": 130.0,
    "final_hold_seconds": 0.3,
    "double_voice": 0.3,
    "double_when": "singing",
    "legato": true,
    "expressive": true,
    "emit_contour": true,
    "contour_range_cents": 300.0,
    "contour_smooth_ms": 60.0,
    "tone_gender": -60.0,
    "tone_tension": 30.0,
    "tone_breath": 0.0,
    "tone_voicing": 100.0,
    "note_scoop_cents": 0.0,
    "note_fall_cents": 0.0,
    "consonant_speed": 100.0,
    "note_attack": 100.0,
    "note_release": 0.0,
    "fx_octave": 0.3,
    "fx_bright": 0.5,
    "fx_drive": 0.0,
    "fx_growl": 0.0,
    "fx_growl_hz": 70.0,
    "fx_ring": 0.0,
    "fx_crush": 0.0,
    "fx_band": 0.0,
