{
  "format": 1,
  "name": "Lo-fi radio",
  "author": "Teto Relay",
  "description": "An old telephone speaker: narrow, crunchy, a little hiss.",
  "settings": {
    "singing_style": "sung",
    "sing_source": "auto",
    "scale": "pentatonic",
    "scale_key": "auto",
    "sung_melody_range": 1.0,
    "sung_contour_amount": 0.3,
    "melody_step": 1.5,
    "melody_min_note_seconds": 0.14,
    "vibrato_min_seconds": 0.35,
    "vibrato_depth_cents": 25.0,
    "vibrato_period_ms": 175.0,
    "final_hold_seconds": 0.3,
    "double_voice": 0.0,
    "double_when": "singing",
    "legato": true,
    "expressive": true,
    "emit_contour": true,
    "contour_range_cents": 300.0,
    "contour_smooth_ms": 60.0,
    "tone_gender": 0.0,
    "tone_tension": -10.0,
    "tone_breath": 0.0,
    "tone_voicing": 100.0,
    "note_scoop_cents": 0.0,
    "note_fall_cents": 0.0,
    "consonant_speed": 100.0,
    "note_attack": 100.0,
    "note_release": 0.0,
    "fx_octave": 0.0,
    "fx_bright": 0.0,
    "fx_drive": 0.25,
    "fx_growl": 0.0,
    "fx_growl_hz": 70.0,
    "fx_ring": 0.0,
    "fx_crush": 0.2,
    "fx_band": 0.9,
    "fx_air": 0.0,
    "fx_chorus": 0.0,
    "fx_reverb": 0.1,
    "fx_size": 0.3
  }
}
